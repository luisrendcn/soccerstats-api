{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "build": "cross-env NODE_ENV=production tsx script/build.ts",
    "build:ci": "npm ci --include=dev && npm run check && npm test && npm run build",
    "start": "cross-env NODE_ENV=production node dist/index.mjs",
    "test": "vitest run --root . server/tests/auth.test.ts server/tests/standings.test.ts server/tests/integration.test.ts",
    "test:real-db": "cross-env RUN_REAL_DB_TESTS=true vitest run --root . server/tests/real-db.test.ts",
    "check": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "apk:debug": "npm run cap:sync && cd android && ./gradlew.bat assembleDebug && cd ..",
    "apk:release": "npm run cap:sync && cd android && ./gradlew.bat assembleRelease && cd .."
  },
