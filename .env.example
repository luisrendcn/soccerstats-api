# Database Configuration
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Required in production. Generate at least 32 random characters.
SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated browser/Capacitor origins allowed to call the API.
API_ORIGINS=https://your-app.example.com,https://localhost,capacitor://localhost

# Keep true in HTTPS deployments. Set false only for local `npm start` over HTTP.
# COOKIE_SECURE=false

# Optional one-time bootstrap account. No default password is created.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-at-least-12-characters
# ADMIN_NAME=Administrador

# Optional demo records for a fresh development database.
# SEED_DEMO_DATA=false

# Used by native builds to reach the deployed API.
# VITE_API_BASE=https://your-api.example.com

# Optional email notifications through Gmail API over HTTPS.
# This works on Render free because it does not use blocked SMTP ports.
# EMAIL_DELIVERY_METHOD=gmail_api
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
# GOOGLE_GMAIL_USER=me
# EMAIL_FROM="Soccer Stats <your-account@gmail.com>"
# ADMIN_NOTIFY_EMAIL=admin@example.com
# APP_PUBLIC_BASE_URL=https://your-app.example.com

# Optional local/paid-instance SMTP fallback.
# Use a Google App Password, not the regular Gmail account password.
# EMAIL_DELIVERY_METHOD=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_SECURE=true
# EMAIL_FORCE_IPV4=true
# EMAIL_CONNECTION_TIMEOUT_MS=10000
# EMAIL_USER=your-account@gmail.com
# EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
