# Database Configuration
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Required in production. Generate at least 32 random characters.
SESSION_SECRET=replace-with-a-long-random-secret

# Comma-separated browser/Capacitor origins allowed to call the API.
API_ORIGINS=https://your-app.example.com,https://localhost,capacitor://localhost

# Keep true in HTTPS deployments. Set false only for local `npm start` over HTTP.
# COOKIE_SECURE=false

# Optional one-time bootstrap account. No default password is created.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-at-least-12-characters
# ADMIN_NAME=Administrador

# Optional demo records for a fresh development database.
# SEED_DEMO_DATA=false

# Used by native builds to reach the deployed API.
# VITE_API_BASE=https://your-api.example.com

# Optional email notifications through Resend.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="Soccer Stats <onboarding@resend.dev>"
# ADMIN_NOTIFY_EMAIL=admin@example.com
# APP_PUBLIC_BASE_URL=https://your-app.example.com

# Optional fallback email notifications through Mailgun.
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.your-domain.com
# MAILGUN_FROM="Soccer Stats <no-reply@mg.your-domain.com>"
